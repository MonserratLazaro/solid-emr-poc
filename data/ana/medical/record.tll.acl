@prefix acl:  <http://www.w3.org/ns/auth/acl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<#public>
    a acl:Authorization ;
    acl:agentClass foaf:Agent ;
    acl:accessTo <./record.ttl> ;
    acl:mode acl:Read .

<#patient>
    a acl:Authorization ;
    acl:agent <http://localhost:3000/ana/profile/card#me> ;
    acl:accessTo <./record.ttl> ;
    acl:mode acl:Read, acl:Write, acl:Control .

<#doctors>
    a acl:Authorization ;
    acl:agentGroup <http://localhost:3000/system/groups/doctors.ttl#group> ;
    acl:accessTo <./record.ttl> ;
    acl:mode acl:Read .